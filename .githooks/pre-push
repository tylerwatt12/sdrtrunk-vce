#!/usr/bin/env bash

set -u

remote_name="$1"
root="$(git rev-parse --show-toplevel)"
checker="$root/tools/verify-publication-policy.sh"
zero=0000000000000000000000000000000000000000
failed=0

while read -r local_ref local_sha remote_ref remote_sha; do
    if [[ "$local_sha" == "$zero" ]]; then
        continue
    fi

    if [[ "$remote_sha" == "$zero" ]]; then
        if ! git rev-list "$local_sha" --not --remotes="$remote_name" | "$checker" --commits; then
            failed=1
        fi
    elif ! "$checker" --range "$remote_sha..$local_sha"; then
        failed=1
    fi
done

exit "$failed"
